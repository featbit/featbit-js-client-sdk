{
  "compilerOptions": {
    "target": "es2016",
    "module": "CommonJS",
    "lib": [
      "es2019",
      "dom"
    ],
    "declaration": false,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "strict": true,
    "outDir": "./dist/cjs",
    "skipLibCheck": true
  },
  "include": [
    "src/**/*"
  ]
}
